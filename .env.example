# Copy to .env.local (development) or set on your host (production).

# Password staff use to sign in at /login. Use a long, unique passphrase.
STAFF_PASSWORD=

# Random secret (at least 32 characters) used to sign staff sessions.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs every staff member out.
SESSION_SECRET=

# Public address of the site, used for links in emails (no trailing slash).
SITE_URL=https://your-domain.com

# Outgoing email (SMTP). Works with Hostinger Mail, Gmail (app password), Resend, etc.
# If SMTP_HOST is empty, emails are saved to data/outbox/ instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: "true" for port 465 (implicit TLS). Defaults to true only when SMTP_PORT=465.
SMTP_SECURE=
# Sender shown to customers, e.g. "Courtside Hub <bookings@your-domain.com>". Defaults to SMTP_USER.
MAIL_FROM=

# ---- Vercel / production storage ------------------------------------------
# Postgres connection string. On Vercel, add Neon from the Marketplace (Storage tab)
# and it sets DATABASE_URL for you. Use the pooled ("-pooler") URL. Locally, leave
# empty to keep using the JSON files in ./data.
DATABASE_URL=
# Connections per server instance (keep small on serverless). Default 3.
PG_POOL_MAX=

# Vercel Blob for uploaded photos and the payment QR. Connecting a Blob store in
# the Vercel dashboard sets this. Leave empty locally to use ./data/uploads.
BLOB_READ_WRITE_TOKEN=
# "public" (default) or "private": must match how the Blob store was created.
BLOB_ACCESS=
